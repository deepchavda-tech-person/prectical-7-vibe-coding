    font-family:"Space Grotesk";
}

.stat p{
    color:#777;
    font-size:13px;
    margin-top:8px;
}

/* ================= SKILLS ================= */

.skills{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.skill{
    min-height:180px;
    padding:25px;
    border:1px solid #1d1d1d;
    border-radius:22px;
    background:linear-gradient(145deg,#111,#080808);
    position:relative;
    overflow:hidden;
    transition:.4s;
}

.skill:hover{
    transform:translateY(-10px) rotateX(4deg);
    border-color:#7657ff;
}

.skill-icon{
    font-size:35px;
    margin-bottom:35px;
}

.skill h3{
    font-size:18px;
}

.skill p{
    color:#666;
    font-size:12px;
    margin-top:8px;
}

/* ================= PROJECTS ================= */

.projects{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:20px;
}

.project{
    min-height:350px;
    padding:30px;
    border:1px solid #202020;
    border-radius:25px;
    position:relative;
    overflow:hidden;
    background:#090909;
    transition:.5s;
}

.project:hover{
    transform:translateY(-12px);
}

.project-visual{
    height:210px;
    border-radius:18px;
    margin-bottom:25px;
    background:
        radial-gradient(circle at 30% 30%,#7657ff,transparent 35%),
        radial-gradient(circle at 70% 60%,#00cfff,transparent 30%),
        #111;
    position:relative;
    overflow:hidden;
}

.project-visual::after{
    content:"";
    position:absolute;
    inset:0;
    background:
        linear-gradient(120deg,transparent,rgba(255,255,255,.15),transparent);
    transform:translateX(-100%);
    transition:1s;
}

.project:hover .project-visual::after{
    transform:translateX(100%);
}

.project h3{
    font-size:22px;
}

.project p{
    color:#777;
    font-size:13px;
    margin-top:8px;
}

/* ================= CTA ================= */

.cta{
    text-align:center;
    padding:120px 30px;
    border:1px solid #222;
    border-radius:35px;
    background:
        radial-gradient(circle at center,rgba(98,65,255,.15),transparent 55%);
}

.cta h2{
    font-family:"Space Grotesk";
    font-size:clamp(45px,7vw,85px);
    line-height:.95;
}

.cta p{
    color:#777;
    margin:25px auto;
    max-width:500px;
