/* ================= FOOTER ================= */

footer{
    width:min(1200px,92%);
    margin:auto;
    padding:35px 0;
    border-top:1px solid #1b1b1b;
    display:flex;
    justify-content:space-between;
    color:#555;
    font-size:12px;
}

/* ================= REVEAL ================= */

.reveal{
    opacity:0;
    transform:translateY(60px);
    transition:1s ease;
}

.reveal.active{
    opacity:1;
    transform:translateY(0);
}

/* ================= MOBILE ================= */

@media(max-width:800px){

    nav ul{
