<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>DEEP — Creative Developer</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Inter,sans-serif;
    background:#050505;
    color:white;
    overflow-x:hidden;
}

/* ================= CURSOR ================= */

.cursor{
    position:fixed;
    width:18px;
    height:18px;
    border:1px solid #fff;
    border-radius:50%;
    pointer-events:none;
    transform:translate(-50%,-50%);
    z-index:9999;
    transition:.08s;
    mix-blend-mode:difference;
}

.cursor-dot{
    position:fixed;
    width:5px;
    height:5px;
    background:white;
    border-radius:50%;
    pointer-events:none;
    transform:translate(-50%,-50%);
    z-index:9999;
}

/* ================= BACKGROUND ================= */

.bg{
    position:fixed;
    inset:0;
    z-index:-5;
    overflow:hidden;
}

.orb{
    position:absolute;
    border-radius:50%;
    filter:blur(100px);
    opacity:.25;
    animation:float 10s infinite alternate ease-in-out;
}

.orb.one{
    width:450px;
    height:450px;
    background:#5b21ff;
    top:-100px;
    left:-100px;
}

.orb.two{
    width:400px;
    height:400px;
    background:#00d9ff;
    right:-100px;
    top:30%;
    animation-delay:2s;
}

.orb.three{
    width:350px;
    height:350px;
    background:#ff2bd6;
    left:30%;
    bottom:-150px;
    animation-delay:4s;
}

@keyframes float{
    from{transform:translate(0,0) scale(1)}
    to{transform:translate(80px,-50px) scale(1.2)}
}

.grid{
    position:absolute;
    inset:0;
    background-image:
        linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
    background-size:55px 55px;
    mask-image:linear-gradient(to bottom,black,transparent);
}

/* ================= NAVBAR ================= */

nav{
    position:fixed;
    top:20px;
    left:50%;
    transform:translateX(-50%);
    width:min(1200px,92%);
    padding:14px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border:1px solid rgba(255,255,255,.12);
    background:rgba(10,10,10,.55);
    backdrop-filter:blur(20px);
    border-radius:50px;
    z-index:1000;
}

.logo{
    font-family:"Space Grotesk";
    font-size:22px;
    font-weight:700;
    letter-spacing:2px;
}

.logo span{
    color:#8b5cf6;
}

nav ul{
    list-style:none;
    display:flex;
    gap:28px;
}

nav a{
    color:#aaa;
    text-decoration:none;
    font-size:13px;
    transition:.3s;
}

nav a:hover{
    color:white;
}

.nav-btn{
    padding:9px 16px;
    border-radius:30px;
    border:1px solid rgba(255,255,255,.2);
}

/* ================= HERO ================= */

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:120px 20px 60px;
    position:relative;
}

.hero-content{
    max-width:1000px;
}

.badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:8px 15px;
    border:1px solid rgba(255,255,255,.15);
    border-radius:50px;
    background:rgba(255,255,255,.04);
    color:#bbb;
    font-size:12px;
    margin-bottom:25px;
    animation:appear 1s ease;
}

.status{
    width:7px;
    height:7px;
    border-radius:50%;
    background:#55ff9a;
    box-shadow:0 0 15px #55ff9a;
}

.hero h1{
    font-family:"Space Grotesk";
    font-size:clamp(60px,11vw,145px);
    line-height:.85;
    letter-spacing:-8px;
    font-weight:700;
}

.gradient{
    background:linear-gradient(
        90deg,
        #fff,
        #9c7cff,
        #45e8ff,
        #fff
    );
    background-size:300%;
    -webkit-background-clip:text;
    color:transparent;
    animation:gradient 6s infinite linear;
}

@keyframes gradient{
    0%{background-position:0%}
    100%{background-position:300%}
}

.hero p{
    max-width:620px;
    margin:30px auto;
    color:#999;
    line-height:1.8;
    font-size:16px;
}

.buttons{
    display:flex;
    justify-content:center;
    gap:14px;
    margin-top:35px;
}

.btn{
    padding:15px 24px;
    border-radius:50px;
    text-decoration:none;
    font-size:14px;
    transition:.35s;
}

.primary{
    color:#050505;
    background:white;
}

.primary:hover{
    transform:translateY(-5px);
    box-shadow:0 15px 50px rgba(255,255,255,.2);
}

.secondary{
    color:white;
    border:1px solid #333;
}

.secondary:hover{
    background:#151515;
    transform:translateY(-5px);
}

.scroll{
    position:absolute;
    bottom:30px;
    color:#666;
    font-size:11px;
    letter-spacing:3px;
    animation:bounce 2s infinite;
}

@keyframes bounce{
    50%{transform:translateY(8px)}
}

/* ================= SECTIONS ================= */

section {
  width: min(100%, 1200px);
  margin: auto;
  padding: 130px 0;
}

.section-label{
    color:#8b5cf6;
    font-size:12px;
    letter-spacing:3px;
    margin-bottom:18px;
}

.section-title{
    font-family:"Space Grotesk";
    font-size:clamp(38px,6vw,70px);
    line-height:1;
    margin-bottom:60px;
