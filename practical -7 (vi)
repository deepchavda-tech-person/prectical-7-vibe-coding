/* ================= ABOUT ================= */

.about{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:70px;
    align-items:center;
}

.about-text p{
    color:#999;
    line-height:1.9;
    margin-bottom:20px;
}

.stats{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

.stat{
    padding:30px;
    border:1px solid #202020;
    border-radius:20px;
    background:rgba(255,255,255,.025);
    transition:.4s;
}

.stat:hover{
    transform:translateY(-8px);
    border-color:#6446ff;
}

.stat h3{
